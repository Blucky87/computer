#!/bin/sh
# Single-monitor X session: the 1080p panel is the only active output.
#
# Used only by `startx1080p`, which points $XINITRC here. Plain `startx`
# reads ~/.xinitrc and is completely unaffected by this file.

userresources=$HOME/.Xresources
usermodmap=$HOME/.Xmodmap
sysresources=/etc/X11/xinit/.Xresources
sysmodmap=/etc/X11/xinit/.Xmodmap

# merge in defaults and keymaps

if [ -f $sysresources ]; then
    xrdb -merge $sysresources
fi

if [ -f $sysmodmap ]; then
    xmodmap $sysmodmap
fi

if [ -f "$userresources" ]; then
    xrdb -merge "$userresources"
fi

if [ -f "$usermodmap" ]; then
    xmodmap "$usermodmap"
fi

# start some nice programs

if [ -d /etc/X11/xinit/xinitrc.d ] ; then
 for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
  [ -x "$f" ] && . "$f"
 done
 unset f
fi

# Tells ~/.config/polybar/launch.sh (run by i3, below) to put up a single bar.
X_LAYOUT=1080p
export X_LAYOUT

# Switch every other output off before i3 starts, so i3 only ever sees one
# screen: every workspace lands on it and nothing is assigned elsewhere.
# --no-bars because i3 starts polybar itself a moment later.
"$HOME/.mycomputer/scripts/xlayout" 1080p --no-bars

xset s off
xset s noblank

exec i3
